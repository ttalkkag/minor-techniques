---
import Page from '../layouts/Page.astro';
import { experiments } from '../data/experiments';

const catalog = [...experiments].sort((first, second) => first.order - second.order);
---

<Page title="실험 목록 · 게임 실험실" description="게임 속 현상을 직접 조절하며 원인과 해결 방법을 알아보는 게임 실험실.">
    <header class="topbar">
        <a class="brand" href="/" aria-label="게임 실험실 처음으로">게임 실험실</a>
    </header>
    <main>
        <div class="list-header">
            <h1>실험 목록</h1>
            <div class="view-switch" role="group" aria-label="목록 보기">
                <button type="button" data-view="thumbnail" aria-label="썸네일 보기" title="썸네일 보기" aria-pressed="true" aria-controls="experiments">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="2" /></svg>
                </button>
                <button type="button" data-view="compact" aria-label="간단 목록 보기" title="간단 목록 보기" aria-pressed="false" aria-controls="experiments">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="3" rx="1" /><rect x="3" y="10.5" width="18" height="3" rx="1" /><rect x="3" y="17" width="18" height="3" rx="1" /></svg>
                </button>
            </div>
        </div>
        <ol id="experiments" class="experiments" data-view="thumbnail">
            {catalog.map((experiment, index) => (
                <li>
                    <a class="experiment" href={experiment.href} aria-labelledby={`${experiment.id}-title`} aria-describedby={`${experiment.id}-description`}>
                        <span class="number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                        <div class="preview" aria-hidden="true">
                            <img src={experiment.thumbnail} width="480" height="340" alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                        </div>
                        <div class="experiment-content">
                            <span class="category">{experiment.tags[0]}</span>
                            <h2 id={`${experiment.id}-title`}>{experiment.title}</h2>
                            <p id={`${experiment.id}-description`}>{experiment.description}</p>
                            <ul class="tags" aria-label="분류, 관찰 방식과 관련 게임">
                                {experiment.tags.map((tag, tagIndex) => <li class:list={{ 'category-tag': tagIndex === 0 }}>{tag}</li>)}
                            </ul>
                            <span class="open-experiment">실험 열기 <span aria-hidden="true">→</span></span>
                        </div>
                    </a>
                </li>
            ))}
        </ol>
    </main>
</Page>

<script>
    const list = document.querySelector<HTMLOListElement>('#experiments');
    const viewButtons = document.querySelectorAll<HTMLButtonElement>('.view-switch button');

    for (const button of viewButtons) {
        button.addEventListener('click', () => {
            if (!list) return;
            const compact = button.dataset.view === 'compact';
            list.dataset.view = compact ? 'compact' : 'thumbnail';
            for (const viewButton of viewButtons) {
                viewButton.setAttribute('aria-pressed', String(viewButton === button));
            }
            for (const experiment of list.querySelectorAll<HTMLAnchorElement>('.experiment')) {
                const description = experiment.querySelector('p');
                if (compact) {
                    experiment.removeAttribute('aria-describedby');
                } else if (description) {
                    experiment.setAttribute('aria-describedby', description.id);
                }
            }
        });
    }
</script>

<style>
    a { color: inherit; text-decoration: none; }
    .topbar { display: flex; align-items: center; min-height: 92px; padding: 24px 40px; }
    .brand { display: inline-flex; align-items: center; min-height: 44px; font-size: 12px; font-weight: 600; color: #53616d; }
    main { width: min(1120px, calc(100% - 80px)); margin: 50px auto 80px; }
    .list-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 18px; margin-bottom: 30px; }
    h1 { margin: 0; font-size: clamp(28px, 3vw, 38px); font-weight: 600; letter-spacing: -1.6px; line-height: 1.3; }
    .view-switch { display: flex; padding: 3px; border: 1px solid #d9e2e5; border-radius: 10px; }
    .view-switch button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 7px; background: transparent; color: #53616d; cursor: pointer; }
    .view-switch button[aria-pressed='true'] { background: #fbfcfc; color: #246d68; box-shadow: 0 1px 4px #334b5512; }
    .view-switch svg { display: block; width: 20px; height: 20px; fill: currentColor; }
    .experiments, .tags { list-style: none; padding: 0; margin: 0; }
    .experiments { display: grid; gap: 16px; }
    .experiment { display: grid; grid-template-columns: 46% 1fr; overflow: hidden; border: 1px solid #d9e2e5; border-radius: 16px; background: #fbfcfc; box-shadow: 0 8px 32px #334b5506; transition: border-color .15s, box-shadow .15s; }
    .experiment:hover { border-color: #a3bfba; box-shadow: 0 10px 35px #334b5510; }
    .number { display: none; }
    .preview { min-width: 0; display: grid; align-items: center; background: #e8eef0; border-right: 1px solid #dce5e7; }
    .preview img { display: block; width: 100%; height: auto; }
    .experiment-content { display: flex; flex-direction: column; align-items: flex-start; padding: 40px 44px; }
    .category { font-size: 12px; font-weight: 600; color: #41736d; }
    h2 { margin: 12px 0 15px; font-size: clamp(25px, 2.7vw, 32px); font-weight: 600; letter-spacing: -1.4px; line-height: 1.3; }
    .experiment-content p { margin: 0; font-size: 13px; line-height: 1.9; color: #5e707a; word-break: keep-all; overflow-wrap: anywhere; }
    .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 23px; }
    .tags li { padding: 5px 9px; border: 1px solid #dce5e7; border-radius: 5px; font-size: 10px; font-weight: 500; color: #5c7078; }
    .experiments[data-view='thumbnail'] .category-tag { display: none; }
    .open-experiment { display: flex; align-items: center; gap: 28px; margin-top: 33px; color: #246d68; font-size: 13px; font-weight: 600; }
    .open-experiment > span { font-size: 21px; font-weight: 400; line-height: 1; }
    .experiments[data-view='compact'] .experiment { grid-template-columns: 36px minmax(0, 1fr); align-items: start; gap: 16px; min-height: 72px; padding: 22px 24px; border-radius: 10px; box-shadow: none; }
    .experiments[data-view='compact'] .number { display: block; color: #637281; font-size: 13px; line-height: 26px; font-variant-numeric: tabular-nums; }
    .experiments[data-view='compact'] :is(.preview, .category, .experiment-content p, .open-experiment) { display: none; }
    .experiments[data-view='compact'] .experiment-content { min-width: 0; padding: 0; flex-direction: row; align-items: center; flex-wrap: wrap; gap: 12px 16px; }
    .experiments[data-view='compact'] h2 { flex: 1 1 160px; margin: 0; font-size: 16px; font-weight: 500; letter-spacing: -.4px; line-height: 1.6; overflow-wrap: anywhere; }
    .experiments[data-view='compact'] .tags { margin: 0 0 0 auto; }
    @media (max-width: 800px) {
        .topbar { min-height: 76px; padding: 16px 24px; }
        main { width: calc(100% - 48px); margin-top: 36px; }
        .experiment { grid-template-columns: 1fr; }
        .preview { border-right: 0; border-bottom: 1px solid #dce5e7; }
        .preview img { width: min(100%, 480px); margin-inline: auto; }
        .experiment-content { padding: 30px; }
        h2 { font-size: 28px; }
    }
    @media (max-width: 420px) {
        .topbar { padding-inline: 20px; }
        main { width: calc(100% - 40px); margin-top: 28px; }
        .list-header { margin-bottom: 22px; }
        .experiment-content { padding: 25px 22px 28px; }
        h2 { font-size: 25px; }
        .experiment-content p { font-size: 12px; }
        .open-experiment { margin-top: 28px; }
        .experiments[data-view='compact'] .experiment { gap: 8px; padding-inline: 18px; }
    }
    @media (prefers-reduced-motion: reduce) {
        .experiment { transition: none; }
    }
</style>
