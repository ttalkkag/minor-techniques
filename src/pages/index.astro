---
import Page from '../layouts/Page.astro';
import AppHeader from '../components/AppHeader.astro';
import '../styles/catalog.css';
import { experiments, listedExperimentIds } from '../data/experiments';

const catalog = [...experiments].sort((first, second) => first.order - second.order);
const listedNumbers = new Map(catalog
    .filter((experiment) => listedExperimentIds.has(experiment.id))
    .map((experiment, index) => [experiment.id, index + 1]));
---

<Page title="실험 목록 · Game lab" description="게임 속 현상을 직접 조절하며 원인과 해결 방법을 알아보는 게임 실험실.">
    <div class="catalog">
        <AppHeader>
            <div class="app-view-switch" role="group" aria-label="목록 보기">
                <button class="app-view-icon" type="button" data-view="thumbnail" aria-label="썸네일 보기" title="썸네일 보기" aria-pressed="true" aria-controls="experiments">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="2" /></svg>
                </button>
                <button class="app-view-icon" type="button" data-view="compact" aria-label="간단 목록 보기" title="간단 목록 보기" aria-pressed="false" aria-controls="experiments">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="3" rx="1" /><rect x="3" y="10.5" width="18" height="3" rx="1" /><rect x="3" y="17" width="18" height="3" rx="1" /></svg>
                </button>
            </div>
        </AppHeader>
        <main class="catalog-main" aria-label="실험 목록">
            <ol id="experiments" class="experiments" data-view="thumbnail">
                {catalog.map((experiment, index) => (
                    <li data-listed={listedNumbers.has(experiment.id)} hidden={!listedNumbers.has(experiment.id)}>
                        <a class="experiment" href={experiment.href} aria-labelledby={`${experiment.id}-title`} aria-describedby={`${experiment.id}-description`}>
                            <span class="number" aria-hidden="true">{String(listedNumbers.get(experiment.id) ?? index + 1).padStart(2, '0')}</span>
                            <div class="preview" aria-hidden="true">
                                <img src={experiment.thumbnail} width="640" height="400" alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                            </div>
                            <div class="experiment-content">
                                <h2 id={`${experiment.id}-title`}>{experiment.title}</h2>
                                <p id={`${experiment.id}-description`}>{experiment.description}</p>
                                <div class="experiment-footer">
                                    <ul class="tags" aria-label="분류, 관찰 방식과 관련 게임">
                                        {experiment.tags.map((tag, tagIndex) => <li class:list={{ 'category-tag': tagIndex === 0 }}>{tag}</li>)}
                                    </ul>
                                    <span class="open-experiment" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
                                    </span>
                                </div>
                            </div>
                        </a>
                    </li>
                ))}
            </ol>
        </main>
    </div>
</Page>

<script>
    const list = document.querySelector<HTMLOListElement>('#experiments');
    const viewButtons = document.querySelectorAll<HTMLButtonElement>('.app-view-switch button');

    const displayAll = new URLSearchParams(window.location.search).get('display') === 'all';
    const items = Array.from(list?.querySelectorAll<HTMLLIElement>(':scope > li') ?? []);
    for (let index = items.length - 1; index > 0; index--) {
        const randomIndex = Math.floor(Math.random() * (index + 1));
        [items[index], items[randomIndex]] = [items[randomIndex]!, items[index]!];
    }
    let visibleNumber = 0;
    for (const item of items) {
        item.hidden = !displayAll && item.dataset.listed !== 'true';
        if (!item.hidden) {
            item.querySelector('.number')!.textContent = String(++visibleNumber).padStart(2, '0');
            item.querySelector('img')!.loading = visibleNumber === 1 ? 'eager' : 'lazy';
        }
    }
    list?.append(...items);

    for (const button of viewButtons) {
        button.addEventListener('click', () => {
            if (!list) return;
            const compact = button.dataset.view === 'compact';
            list.dataset.view = compact ? 'compact' : 'thumbnail';
            for (const viewButton of viewButtons) {
                viewButton.setAttribute('aria-pressed', String(viewButton === button));
            }
            for (const experiment of list.querySelectorAll<HTMLAnchorElement>('.experiment')) {
                const description = experiment.querySelector('p');
                if (compact) {
                    experiment.removeAttribute('aria-describedby');
                } else if (description) {
                    experiment.setAttribute('aria-describedby', description.id);
                }
            }
        });
    }
</script>
