---
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import ExperimentPlayback from '../../components/ExperimentPlayback.astro';
---

<ExperimentLayout
    helpId="explain"
    title="몸은 지나가는데 카메라는 막힌다 | 게임 실험실"
    description="문 폭·몸 반지름·카메라 프로브를 각각 조절해 통과하세요."
    id="lab"
    class="lab"
>
    <Fragment slot="settings">
        <div class="settings-inputs">
            <label for="width">
                문 폭 (m) <output id="width-value">1.2</output>
                <input id="width" type="range" min="0.6" max="3" value="1.2" step="0.1" />
            </label>
            <label for="radius">
                이동체 반지름 (m) <output id="radius-value">0.4</output>
                <input id="radius" type="range" min="0.2" max="0.7" value="0.4" step="0.05" />
            </label>
            <label for="arm">
                카메라 거리 (m) <output id="arm-value">3</output>
                <input id="arm" type="range" min="1" max="5" value="3" step="0.1" />
            </label>
            <label for="probe">
                카메라 프로브 반지름 (m) <output id="probe-value">0.2</output>
                <input id="probe" type="range" min="0.05" max="0.6" value="0.2" step="0.05" />
            </label>
            <label for="shoulder">
                어깨 오프셋 (m) <output id="shoulder-value">0.8</output>
                <input id="shoulder" type="range" min="0" max="1.5" value="0.8" step="0.1" />
            </label>
            <label for="fov">
                수직 시야각 (도) <output id="fov-value">65</output>
                <input id="fov" type="range" min="40" max="100" value="65" step="5" />
            </label>
            <label class="check">
                <input type="checkbox" id="collision" checked />
                카메라 장애물 검사
            </label>
        </div>
    </Fragment>
    <Fragment slot="body-header">
        <h1>
            <small>게임 실험실 · 카메라와 레벨</small>몸은 지나가는데 카메라는 막힌다
        </h1>
    </Fragment>
    <Fragment slot="graphics">
        <section class="scene" aria-label="몸은 지나가는데 카메라는 막힌다 실험 장면">
            <canvas id="scene" aria-label="대화형 실험 장면"></canvas>
        </section>
    </Fragment>
    <Fragment slot="description">
        <p id="readout">실험을 준비하고 있습니다.</p>
        <p id="hint">
            재생하면 문을 향해 전진합니다. WASD / 방향키로 직접 이동할 수도 있습니다. 위: 이동 단면 / 아래: 같은 카메라의 투영 화면.
        </p>
    </Fragment>
    <Fragment slot="controls">
        <ExperimentPlayback />
        <div class="touch">
            <button data-key="ArrowLeft" aria-label="왼쪽">
                ←
            </button>
            <button data-key="ArrowUp" aria-label="앞으로">
                ↑
            </button>
            <button data-key="ArrowDown" aria-label="뒤로">
                ↓
            </button>
            <button data-key="ArrowRight" aria-label="오른쪽">
                →
            </button>
        </div>
        <button id="center">문 중앙에 정렬</button>
    </Fragment>
    <Fragment slot="overlays">
        <dialog id="info" aria-labelledby="info-title">
            <h2 id="info-title" tabindex="-1">몸은 지나가는데 카메라는 막힌다</h2>
            <h3>문제</h3>
            <p>문 앞에서 캐릭터가 멈추는 것과 벽이 화면을 가리는 것은 별개의 실패입니다.</p>
            <h3>원인</h3>
            <p>
                문이 이동체 지름보다 넓으면 그 차이만큼 중심을 맞출 여유가 생깁니다. 더 좁으면 통과 위치가
                없고, 같으면 여유가 없는 이상적 접촉 경계입니다. 카메라는 캐릭터 뒤쪽의 별도 위치를 사용합니다.
            </p>
            <h3>해결을 관찰하기</h3>
            <p>
                위 단면에서 원과 벽 충돌을 확인합니다. 카메라 프로브가 벽에 닿으면 팔 길이를 줄이고, FOV를
                바꿔 화면 변화와 이동 판정의 차이를 비교합니다.
            </p>
            <h3>선택의 대가와 모형 범위</h3>
            <p>
                큰 문은 건물 비율을 바꿉니다. 짧은 카메라는 캐릭터를 크게 보이게 합니다. 수평 2D 원-상자
                충돌과 그 결과의 원근 투영이며 높이·단차·캡슐 기울기는 생략했습니다. 카메라 팔의 충돌 위치는
                400단계로 근사합니다.
            </p>
            <h3>근거</h3>
            <a
                href="https://docs.unity3d.com/6000.0/Documentation/Manual/class-CharacterController.html"
                target="_blank"
                rel="noreferrer"
            >
                Unity Character Controller ↗
            </a>
            <a
                href="https://dev.epicgames.com/documentation/unreal-engine/API/Runtime/Engine/USpringArmComponent"
                target="_blank"
                rel="noreferrer"
            >
                Epic Spring Arm ↗
            </a>
            <button id="close-info">장면으로 돌아가기</button>
        </dialog>
    </Fragment>
    <script>
        import '../../experiments/door-clearance/client';
    </script>
</ExperimentLayout>
<style>
    .scene { position: relative; width: 100%; height: 100%; min-height: 0; }
    button,
    select {
        min-height: 42px;
        border: 1px solid #b8cbcd;
        border-radius: 9px;
        padding: 8px 12px;
        background: #fff;
        color: #244247;
        cursor: pointer;
    }
    button:hover {
        background: #dcece7;
    }
    button:active {
        background: #b7ded2;
    }
    button:disabled {
        opacity: 0.5;
        cursor: default;
    }
    .settings-inputs label {
        display: block;
        font-size: 13px;
        margin: 0 0 20px;
        line-height: 1.4;
    }
    .settings-inputs input[type='range'] {
        display: block;
        width: 100%;
        accent-color: #187d74;
        margin: 10px 0 0;
        min-height: 25px;
    }
    .settings-inputs select {
        display: block;
        width: 100%;
        margin-top: 8px;
        font-size: 13px;
    }
    .settings-inputs output {
        float: right;
        font-variant-numeric: tabular-nums;
        color: #16786f;
    }
    .settings-inputs .check {
        display: flex;
        gap: 10px;
        align-items: center;
        min-height: 40px;
        margin-bottom: 8px;
    }
    .settings-inputs input[type='checkbox'] {
        width: 19px;
        height: 19px;
        accent-color: #187d74;
    }
    canvas,
    #webgl {
        display: block;
        width: 100%;
        height: 100%;
        touch-action: none;
    }
    #readout {
        font-size: 13px;
        line-height: 1.6;
        margin: 0 0 4px;
        font-variant-numeric: tabular-nums;
        min-height: 21px;
    }
    #hint {
        font-size: 12px;
        color: #52676d;
        margin: 0 0 8px;
    }
    .touch {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
        align-items: center;
        width: 100%;
    }
    .touch button {
        min-width: 48px;
        user-select: none;
        touch-action: none;
    }
    .touch #choices {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }
    .touch #choices button {
        font-size: 12px;
        min-height: 40px;
    }
    dialog {
        max-width: 610px;
        width: calc(100% - 28px);
        max-height: 85svh;
        border: 1px solid #c4d5d3;
        border-radius: 17px;
        padding: 28px;
        color: #243744;
        background: #f9fcfa;
    }
    dialog::backdrop {
        background: #1f393e77;
        backdrop-filter: blur(4px);
    }
    dialog h2 {
        font-size: 21px;
        margin-top: 0;
    }
    dialog h3 {
        font-size: 14px;
        color: #11756d;
        margin: 20px 0 5px;
    }
    dialog p {
        font-size: 14px;
        line-height: 1.75;
        margin: 0;
    }
    dialog a {
        display: block;
        font-size: 13px;
        color: #146d6a;
        margin: 8px 0;
        overflow-wrap: anywhere;
    }
    dialog button {
        margin-top: 20px;
        width: 100%;
    }
    @media (max-width: 800px) {
        #readout {
            font-size: 12px;
        }
        #hint {
            font-size: 11px;
            line-height: 1.4;
        }
        .touch {
            gap: 6px;
        }
        dialog {
            padding: 22px;
        }
        .touch button {
            min-width: 44px;
        }
    }
</style>
