        max-height: 225px;
        overflow: auto;
        font-size: 12px;
        line-height: 1.8;
        margin: 0;
        padding-left: 20px;
    }
    .chart {
        width: 100%;
        height: auto;
        display: block;
    }
    .token-row {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }
    .token {
        width: 32px;
        height: 36px;
        display: grid;
        place-content: center;
        border-radius: 6px;
        background: #e0e9e5;
        font-size: 13px;
    }
    .token.hit {
        background: #207f70;
        color: white;
    }
    .token.miss {
        background: #e8d4c7;
        color: #743e25;
    }
    .big {
        font-size: 38px;
        font-weight: 750;
        line-height: 1.3;
        margin: 12px 0;
        color: #17766c;
    }
    .rowlabel {
