        align-items: center;
        gap: 8px;
        min-height: 42px;
    }
    .check input {
        width: 18px;
        height: 18px;
        accent-color: #147b72;
    }
    .settings p,
    .note {
        font-size: 12px;
        line-height: 1.7;
        color: #537079;
    }
    .stage {
        flex: 1;
        min-width: 0;
        padding: 22px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
