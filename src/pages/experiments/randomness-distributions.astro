    }
    dialog {
        max-width: min(680px, calc(100vw - 28px));
        max-height: 85svh;
        border: 1px solid #bbd1cd;
        border-radius: 16px;
        background: #fbfdfc;
        color: #29434a;
        padding: 25px;
    }
    dialog::backdrop {
        background: #244f5966;
    }
    dialog h2 {
        font-size: 21px;
        margin-top: 0;
    }
    dialog h3 {
        font-size: 15px;
        color: #137367;
        margin-bottom: 5px;
    }
    dialog p {
        font-size: 14px;
        line-height: 1.8;
    }
    dialog a {
        color: #14786c;
    }
    .dialog-heading {
        display: flex;
