    }
    .surface {
        background: #f9fcfb;
        border: 1px solid #cbdcdd;
        border-radius: 16px;
        padding: 22px;
        min-width: 0;
    }
    .surface h2 {
        font-size: 16px;
        margin: 0 0 16px;
    }
    .split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    .actions {
        display: flex;
