        cursor: default;
    }
    button.primary {
        background: #187c72;
        color: #fff;
        border-color: #187c72;
    }
    .menu {
        font-size: 20px;
        min-width: 44px;
        padding: 4px;
    }
    main {
        display: flex;
        flex: 1;
        min-width: 0;
    }
    .settings {
