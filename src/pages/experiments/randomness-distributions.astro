        height: 20px;
        border-radius: 5px;
        overflow: hidden;
        background: #dbe6e3;
        position: relative;
        margin: 9px 0 16px;
    }
    .bar > i {
        display: block;
        height: 100%;
        background: #19877a;
        transition: width 0.15s;
    }
    .bar > em {
        position: absolute;
        top: 0;
        height: 100%;
        background: #e7ad61;
    }
