        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }
    .metric {
        background: white;
        border: 1px solid #cbdcdd;
        border-radius: 12px;
        padding: 13px 16px;
        flex: 1;
        min-width: 125px;
    }
    .metric small {
        font-size: 12px;
        color: #56747b;
