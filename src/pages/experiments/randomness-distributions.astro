        margin: 0;
    }
    #close-menu {
        flex: 0 0 42px;
        font-size: 22px;
    }
    .menu-backdrop {
        position: fixed;
        inset: 0;
        z-index: 4;
        background: #244f5966;
    }
    .settings h2 {
        font-size: 14px;
        margin: 0;
    }
    .settings label {
