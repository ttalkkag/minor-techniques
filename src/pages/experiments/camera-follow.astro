---
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import ExperimentPlayback from '../../components/ExperimentPlayback.astro';
---

<ExperimentLayout
    title="방향을 바꾸면 카메라는 어디를 볼까? | 게임 실험실"
    description="전방 오프셋·감쇠·데드존과 화면 경계를 바꾸며 달려 보세요."
    id="lab"
    class="lab"
    helpId="explain"
>
    <Fragment slot="settings">
        <div class="settings-inputs">
            <label>
                목표 생성
                <select id="mode">
                    <option value="offset">진행 방향 오프셋</option>
                    <option value="center">캐릭터 중앙</option>
                    <option value="velocity">속도 예측</option>
                </select>
            </label>
            <label for="offset">
                전방 거리 (m) <output id="offset-value">3</output>
                <input id="offset" type="range" min="0" max="6" value="3" step="0.5" />
            </label>
            <label for="half">
                오차 반감기 (초) <output id="half-value">0.2</output>
                <input id="half" type="range" min="0.05" max="1" value="0.2" step="0.05" />
            </label>
            <label for="dead">
                데드존 반폭 (m) <output id="dead-value">1</output>
                <input id="dead" type="range" min="0" max="4" value="1" step="0.25" />
            </label>
            <label for="view">
                화면 세계 폭 (m) <output id="view-value">20</output>
                <input id="view" type="range" min="12" max="44" value="20" step="2" />
            </label>
            <label>
                감쇠식
                <select id="damping">
                    <option value="time">시간 기반</option>
                    <option value="frame">프레임마다 10%</option>
                </select>
            </label>
            <label>
                모의 갱신률
                <select id="fps">
                    <option value="60">60 FPS</option>
                    <option value="30">30 FPS</option>
                </select>
            </label>
            <label class="check">
                <input type="checkbox" id="hysteresis" checked />
                0.25초 방향 전환 유예
            </label>
            <label class="check">
                <input type="checkbox" id="confine" checked />
                화면 가장자리까지 방 안에 제한
            </label>
        </div>
    </Fragment>
    <Fragment slot="body-header">
        <h1>
            <small>게임 실험실 · 카메라와 레벨</small>방향을 바꾸면 카메라는 어디를 볼까?
        </h1>
    </Fragment>
    <Fragment slot="graphics">
        <section class="scene" aria-label="방향을 바꾸면 카메라는 어디를 볼까? 실험 장면">
            <canvas id="scene" aria-label="대화형 실험 장면"></canvas>
        </section>
    </Fragment>
    <Fragment slot="description">
        <p id="readout">실험을 준비하고 있습니다.</p>
        <p id="hint">← → / A D 또는 아래 버튼으로 이동 · 40m를 넘으면 다음 방이 열립니다.</p>
    </Fragment>
    <Fragment slot="controls">
        <ExperimentPlayback>
            <span>캐릭터 자동 왕복 · 한 단계는 모의 1프레임</span>
        </ExperimentPlayback>
        <div class="touch">
            <button data-key="ArrowLeft" aria-label="왼쪽 이동">
                ←
            </button>
            <button data-key="ArrowRight" aria-label="오른쪽 이동">
                →
            </button>
        </div>
        <button id="teleport">비밀방으로 이동</button>
    </Fragment>
    <Fragment slot="overlays">
        <dialog id="info" aria-labelledby="info-title">
            <h2 id="info-title" tabindex="-1">방향을 바꾸면 카메라는 어디를 볼까?</h2>
            <h3>문제</h3>
            <p>
                캐릭터를 중앙에 두면 전방과 후방에 같은 공간을 배정합니다. 방향 오프셋을 즉시 뒤집으면 목표가
                한 번에 멀리 이동합니다.
            </p>
            <h3>원인</h3>
            <p>
                목표 생성, 무반응 영역, 추적 속도, 방 경계는 다른 규칙입니다. 중심만 방 안에 가두면 화면
                가장자리는 이웃 방을 드러냅니다.
            </p>
            <h3>해결을 관찰하기</h3>
            <p>
                방향 유예와 데드존을 비교하고 시간 기반 감쇠로 따라갑니다. 화면 반폭을 뺀 중심 범위에
                제한합니다. 좁은 방보다 화면이 크면 여백을 표시합니다.
            </p>
            <h3>선택의 대가와 모형 범위</h3>
            <p>
                전방을 더 보여 주면 후방은 덜 보입니다. 긴 반감기는 움직임을 줄이지만 반응을 늦춥니다. 단순
                직교 2D 모형이며 원작이나 Cinemachine 실행 결과가 아닙니다.
            </p>
            <h3>근거</h3>
            <a
                href="https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachinePositionComposer.html"
                target="_blank"
                rel="noreferrer"
            >
                Unity Position Composer ↗
            </a>
            <a
                href="https://docs.unity3d.com/Packages/com.unity.cinemachine@3.1/manual/CinemachineConfiner2D.html"
                target="_blank"
                rel="noreferrer"
            >
                Unity Confiner 2D ↗
            </a>
            <button id="close-info">장면으로 돌아가기</button>
        </dialog>
    </Fragment>
    <script>
        import '../../experiments/camera-follow/client';
    </script>
</ExperimentLayout>
<style>
    .scene { position: relative; width: 100%; height: 100%; min-height: 0; }
    button,
    select {
        min-height: 42px;
        border: 1px solid #b8cbcd;
        border-radius: 9px;
        padding: 8px 12px;
        background: #fff;
        color: #244247;
        cursor: pointer;
    }
    button:hover {
        background: #dcece7;
    }
    button:active {
        background: #b7ded2;
    }
    button:disabled {
        opacity: 0.5;
        cursor: default;
    }
    .settings-inputs label {
        display: block;
        font-size: 13px;
        margin: 0 0 20px;
        line-height: 1.4;
    }
    .settings-inputs input[type='range'] {
        display: block;
        width: 100%;
        accent-color: #187d74;
        margin: 10px 0 0;
        min-height: 25px;
    }
    .settings-inputs select {
        display: block;
        width: 100%;
        margin-top: 8px;
        font-size: 13px;
    }
    .settings-inputs output {
        float: right;
        font-variant-numeric: tabular-nums;
        color: #16786f;
    }
    .settings-inputs .check {
        display: flex;
        gap: 10px;
        align-items: center;
        min-height: 40px;
        margin-bottom: 8px;
    }
    .settings-inputs input[type='checkbox'] {
        width: 19px;
        height: 19px;
        accent-color: #187d74;
    }
    canvas,
    #webgl {
        display: block;
        width: 100%;
        height: 100%;
        touch-action: none;
    }
    #readout {
        font-size: 13px;
        line-height: 1.6;
        margin: 0 0 4px;
        font-variant-numeric: tabular-nums;
        min-height: 21px;
    }
    #hint {
        font-size: 12px;
        color: #52676d;
        margin: 0 0 8px;
    }
    .touch {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
    }
    .touch button {
        min-width: 48px;
        user-select: none;
        touch-action: none;
    }
    .touch #choices {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }
    .touch #choices button {
        font-size: 12px;
        min-height: 40px;
    }
    dialog {
        max-width: 610px;
        width: calc(100% - 28px);
        max-height: 85svh;
        border: 1px solid #c4d5d3;
        border-radius: 17px;
        padding: 28px;
        color: #243744;
        background: #f9fcfa;
    }
    dialog::backdrop {
        background: #1f393e77;
        backdrop-filter: blur(4px);
    }
    dialog h2 {
        font-size: 21px;
        margin-top: 0;
    }
    dialog h3 {
        font-size: 14px;
        color: #11756d;
        margin: 20px 0 5px;
    }
    dialog p {
        font-size: 14px;
        line-height: 1.75;
        margin: 0;
    }
    dialog a {
        display: block;
        font-size: 13px;
        color: #146d6a;
        margin: 8px 0;
        overflow-wrap: anywhere;
    }
    dialog button {
        margin-top: 20px;
        width: 100%;
    }
    @media (max-width: 800px) {
        #readout {
            font-size: 12px;
        }
        #hint {
            font-size: 11px;
            line-height: 1.4;
        }
        .touch {
            gap: 6px;
        }
        dialog {
            padding: 22px;
        }
        .touch button {
            min-width: 44px;
        }
    }
</style>
