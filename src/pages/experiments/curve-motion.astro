---
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import ExperimentPlayback from '../../components/ExperimentPlayback.astro';
---

<ExperimentLayout
    helpId="explain"
    title="같은 곡선, 다른 속력 · 게임 실험실"
    description="제어점과 거리 표의 해상도를 바꾸며 균일 매개변수와 균일 거리 이동을 비교합니다."
>
    <Fragment slot="settings">
        <label for="shape">경로 예시</label>
        <select id="shape">
            <option value="curve">굽은 경로</option>
            <option value="cubic">직선도 느려지는 10u³</option>
            <option value="point">모든 제어점이 같은 점</option>
        </select>
        <label for="bend">
            제어점 높이
            <output id="bend-out"></output>
        </label>
        <input id="bend" type="range" min="0" max="200" value="150" />
        <label for="samples">
            거리 표 분할 수
            <output id="samples-out"></output>
        </label>
        <input id="samples" type="range" min="4" max="256" value="64" step="4" />
        <label for="scale">
            가로 확대
            <output id="scale-out"></output>
        </label>
        <input id="scale" type="range" min="0.5" max="1.6" value="1" step="0.1" />
        <label for="metric">거리 측정 좌표계</label>
        <select id="metric">
            <option value="world">확대 후 화면 좌표</option>
            <option value="local">확대 전 로컬 좌표</option>
        </select>
        <label>
            <input id="construction" type="checkbox" checked />
            반복 선형 보간과 거리 표
        </label>
    </Fragment>
    <Fragment slot="body-header">
        <p class="eyebrow">움직임의 조건을 바꾸다</p>
        <h1>같은 곡선, 다른 속력</h1>
        <p class="lead">
            제어점과 거리 표의 해상도를 바꾸며 균일 매개변수와 균일 거리 이동을 비교합니다.
        </p>
    </Fragment>
    <Fragment slot="graphics">
        <div class="scene">
            <svg
                id="scene"
                viewBox="0 0 1000 430"
                role="img"
                aria-label="베지에 제어점과 두 이동 방식"
                aria-describedby="summary"
            ></svg>
        </div>
    </Fragment>
    <Fragment slot="description">
        <section class="results" aria-label="관찰 결과">
            <article class="card">
                <span class="orange">A · 균일 u</span>
                <strong id="a-readout"></strong>
            </article>
            <article class="card">
                <span class="teal">B · 거리 역조회</span>
                <strong id="b-readout"></strong>
            </article>
            <article class="card">
                <span>화면 길이 / 거리 표 오차</span>
                <strong id="error-readout"></strong>
            </article>
        </section>
        <p class="hint" id="summary" role="status"></p>
    </Fragment>
    <Fragment slot="controls">
        <ExperimentPlayback playId="play" stepId="step" resetId="reset">한 단계: 진행 5%</ExperimentPlayback>
        <div class="controls">
            <label for="progress">
                진행
                <input id="progress" type="range" min="0" max="1000" value="250" />
            </label>
        </div>
    </Fragment>
    <Fragment slot="overlays">
        <dialog id="explanation" aria-labelledby="explanation-title">
            <button class="close" id="close-explain" aria-label="설명 닫기">×</button>
            <h2 id="explanation-title">같은 곡선, 다른 속력</h2>
            <h3>문제 · 제어점 간격은 이동 거리가 아닙니다</h3>
            <p>
                같은 u 간격도 곡선의 도함수 크기에 따라 서로 다른 거리를 만듭니다. 직선 예시
                B(u)=10u³는 절반 시간에 1.25만 이동합니다.
            </p>
            <h3>해결 · 거리를 먼저 정하고 u를 찾습니다</h3>
            <p>
                선분 길이를 누적한 표에서 원하는 거리를 끼우는 두 항목을 찾아 u를 보간합니다. 가로
                확대와 제어점이 바뀌면 표를 다시 만듭니다. 회색 점은 표의 샘플, 가는 선은 반복
                보간입니다.
            </p>
            <h3>대가와 범위</h3>
            <p>
                표가 작으면 굴곡에서 속력 편차가 남습니다. 표시 오차는 4096분할 참조 길이에 대한
                차이이며 정확한 해석 길이가 아닙니다. 로컬 거리로 만든 표를 비균일 확대하면 화면
                속력이 변합니다. 길이 0은 그 자리에 머뭅니다. 이 장면은 2D 베지에와 선분 근사입니다.
            </p>
            <p>
                <a href="https://www.w3.org/TR/SVG2/paths.html">W3C SVG 경로</a>
                ·{' '}
                <a href="https://docs.godotengine.org/en/stable/classes/class_curve2d.html">
                    Godot Curve2D 거리 캐시
                </a>
            </p>
        </dialog>
    </Fragment>
    <script>
        import '../../experiments/curve-motion/client';
    </script>
</ExperimentLayout>
<style>
    :global(body) {
        background: #edf1f3;
        color: #203d43;
        margin: 0;
    }
    button,
    select,
    input {
        font: inherit;
    }
    button,
    select {
        min-height: 42px;
        border: 1px solid #b7ced0;
        border-radius: 12px;
        background: #fff;
        color: #234b50;
        padding: 8px 15px;
        cursor: pointer;
    }
    button:hover {
        background: #ddefec;
    }
    button:focus-visible,
    select:focus-visible,
    input:focus-visible,
    a:focus-visible {
        outline: 3px solid #e8954b;
        outline-offset: 3px;
    }
    .eyebrow {
        font-size: 12px;
        letter-spacing: 0.12em;
        color: #46666a;
    }
    h1 {
        font-size: clamp(24px, 3.5vw, 42px);
        margin: 8px 0;
    }
    h2 {
        font-size: 20px;
    }
    p {
        line-height: 1.65;
    }
    .lead {
        color: #577176;
        margin: 8px 0;
    }
    .scene {
        width: 100%;
        height: 100%;
        min-height: 0;
        position: relative;
    }
    .scene svg,
    .scene canvas {
        width: 100%;
        height: 100%;
        min-height: 280px;
        display: block;
    }
    .scene svg text {
        font-family: inherit;
        fill: #24474c;
    }
    .scene canvas {
        width: 100%;
        height: 100%;
        min-height: 280px;

        border-radius: 20px;
    }
    .results {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }
    .card {
        background: #ffffffbd;
        border: 1px solid #d4e0e2;
        border-radius: 15px;
        padding: 14px 18px;
        flex: 1;
        min-width: 180px;
    }
    .card strong {
        display: block;
        font-size: 18px;
        margin: 4px 0;
    }
    .card span {
        font-size: 13px;
        color: #587177;
    }
    .controls {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }
    .controls label {
        display: flex;
        flex-wrap: wrap;
        width: 100%;
        min-width: 0;
        align-items: center;
        gap: 10px;
    }
    .controls input {
        width: 100%;
        min-width: 0;
        min-height: 40px;
        accent-color: #11797b;
    }
    :global(.experiment-settings) label {
        display: block;
        font-size: 14px;
        margin: 19px 0 7px;
    }
    :global(.experiment-settings) input[type="range"] {
        width: 100%;
        accent-color: #14797b;
        min-height: 40px;
    }
    :global(.experiment-settings) input[type="checkbox"] {
        accent-color: #14797b;
        width: 20px;
        height: 20px;
        vertical-align: middle;
        margin-right: 8px;
    }
    :global(.experiment-settings) select {
        width: 100%;
    }
    :global(.experiment-settings) output {
        float: right;
        font-variant-numeric: tabular-nums;
    }
    :global(.experiment-settings) .row {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-top: 16px;
    }
    .hint {
        text-align: center;
        color: #46666a;
        font-size: 13px;
    }
    .teal {
        color: #087d7a;
    }
    .orange {
        color: #cb713c;
    }
    dialog {
        border: 1px solid #b8ced0;
        border-radius: 22px;
        max-width: 650px;
        width: calc(100vw - 56px);
        max-height: 80dvh;
        padding: 25px;
        box-sizing: border-box;
        color: #24474c;
        background: #f9fcfc;
    }
    dialog::backdrop {
        background: #24444777;
    }
    dialog h2 {
        margin-top: 0;
    }
    dialog h3 {
        font-size: 16px;
        margin-bottom: 4px;
    }
    dialog p {
        font-size: 14px;
        margin-top: 6px;
    }
    dialog a {
        color: #0b777a;
    }
    dialog .close {
        float: right;
        margin-left: 12px;
    }
    .log {
        max-width: 1030px;
        margin: 8px auto 30px;
        max-height: 135px;
        overflow: auto;
        border-radius: 12px;
        background: white;
        padding: 14px 20px;
        font-size: 13px;
        line-height: 1.6;
    }
    .object-list {
        display: flex;
        justify-content: center;
        gap: 6px;
        flex-wrap: wrap;
    }
    .object-list button[aria-pressed="true"] {
        background: #146f72;
        color: #fff;
    }
    @media (max-width: 600px) {
        .lead {
            font-size: 14px;
        }
        .scene {
            width: 100%;
            height: 100%;
            min-height: 0;
            position: relative;
        }
        .scene svg {
            width: 100%;
            height: 100%;
            min-height: 280px;
        }
        .results {
            gap: 7px;
        }
        .card {
            padding: 10px 12px;
            min-width: 120px;
        }
        .card strong {
            font-size: 15px;
        }
        .card span {
            font-size: 12px;
        }
        .controls {
            gap: 7px;
        }
        .hint {
            font-size: 12px;
        }
        .log {
            margin: 8px 12px 20px;
        }
        .scene canvas {
            width: 100%;
            height: 100%;
            min-height: 280px;
        }
    }
</style>
