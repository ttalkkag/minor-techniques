---
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import ExperimentPlayback from '../../components/ExperimentPlayback.astro';
import ExperimentViewSwitch from '../../components/ExperimentViewSwitch.astro';
---

<ExperimentLayout
    helpId="help"
    title="엄폐한 뒤에 맞는 이유 · Game lab"
    description="달리는 표적을 쏘고, 사수와 표적의 시점을 오가며 지연 보상을 살펴보세요."
    class="lag-lab"
    settingsId="settings"
    menuId="menu"
    closeSettingsId="close"
    backdropId="backdrop"
>
    <Fragment slot="header-actions">
        <ExperimentViewSwitch id="view" label="관찰 시점" options={[
            { value: 'free', label: '자유' },
            { value: 'shooter', label: '사수' },
            { value: 'target', label: '표적' },
        ]} />
        <button id="history-toggle" class="history-toggle" aria-pressed="true" title="서버가 사격을 검사한 모습 표시">판정 기록</button>
    </Fragment>
    <Fragment slot="controls">
        <ExperimentPlayback resetLabel="재생 처음으로" />
        <div class="clip-controls">
            <label for="scrub">장면 되감기<output id="scrub-value">0%</output></label>
            <input id="scrub" type="range" min="0" max="1000" step="1" value="0" />
            <div class="timeline-marks" aria-hidden="true"><span>접근</span><span>발사</span><span>판정</span></div>
            <label for="rate">재생 속도</label>
            <select id="rate">
                <option value="0.1">0.1× · 느리게</option>
                <option value="0.25">0.25×</option>
                <option value="1">1×</option>
            </select>
            <button id="fire" class="action-button">발사 순간부터 보기</button>
        </div>
    </Fragment>
    <Fragment slot="settings">
        <label for="mode">판정 방식</label>
        <select id="mode">
            <option value="history">지연 보상 켜기</option>
            <option value="current">지연 보상 끄기</option>
        </select>
        <button id="compare" class="action-button compare-button">보상 끄고 다시 보기</button>
        <label for="up">사격 명령이 가는 시간<output id="up-value"></output></label>
        <input id="up" type="range" min="0" max="180" step="10" value="40" />
        <label for="down">서버 소식이 오는 시간<output id="down-value"></output></label>
        <input id="down" type="range" min="0" max="180" step="10" value="40" />
        <label for="interpolation">화면 보간 대기<output id="interpolation-value"></output></label>
        <input id="interpolation" type="range" min="0" max="100" step="10" value="40" />
        <label for="speed">표적 이동 속도<output id="speed-value"></output></label>
        <input id="speed" type="range" min="1" max="10" step="1" value="5" />
        <label for="aim">조준 위치 옮기기<output id="aim-value"></output></label>
        <input id="aim" type="range" min="-0.8" max="0.8" step="0.05" value="0" />
        <details class="advanced">
            <summary>고급 설정</summary>
            <label for="window">저장 이력 길이<output id="window-value"></output></label>
            <input id="window" type="range" min="50" max="400" step="25" value="250" />
            <label for="hz">이력 저장 빈도<output id="hz-value"></output></label>
            <input id="hz" type="range" min="10" max="120" step="10" value="60" />
            <label for="clock">판정 시각 계산</label>
            <select id="clock">
                <option value="aligned">편도 둘 + 보간량 반영</option>
                <option value="half">RTT/2만 사용</option>
            </select>
            <label for="limit">이력 초과 정책</label>
            <select id="limit">
                <option value="reject">명령 거부</option>
                <option value="clamp">가장 오래된 시각으로 제한</option>
            </select>
            <label for="claim">명령 시각 검사</label>
            <select id="claim">
                <option value="normal">정상 시각</option>
                <option value="future">미래 시각으로 위조</option>
                <option value="forged">80ms 더 과거로 위조</option>
            </select>
            <label class="check"><input id="subtick" type="checkbox" checked />틱 사이 위치 보간</label>
            <label class="check"><input id="teleport" type="checkbox" />이동 중 순간이동</label>
            <button id="duplicate" class="action-button" disabled>같은 명령 재전송</button>
            <p id="command-status" class="small-status" role="status"></p>
            <p id="history-info" class="small-status"></p>
        </details>
    </Fragment>
    <Fragment slot="body-header">
        <p class="eyebrow">네트워크 · 지연 보상</p>
        <h1>엄폐한 뒤에 맞는 이유</h1>
    </Fragment>
    <Fragment slot="graphics">
        <section class="stage" aria-label="지연 보상 사격장">
            <canvas id="scene" tabindex="0" aria-label="3D 사격장. 드래그로 회전, 휠로 확대, 오른쪽 드래그로 이동. 키보드 방향키로 회전, 더하기와 빼기로 확대, Home으로 시점 복원." aria-describedby="summary"></canvas>
            <div class="scene-footer">
                <div class="legend"><span class="target-key">표적</span><span class="shot-key">사수의 한 발</span><span class="history-key">서버의 판정</span></div>
                <span class="camera-hint desktop-hint">드래그 회전 · 휠 확대 · 우클릭 이동</span>
                <span class="camera-hint touch-hint">한 손가락 회전 · 두 손가락 이동/확대</span>
            </div>
            <p id="scene-error" class="scene-error" role="alert" hidden></p>
        </section>
    </Fragment>
    <Fragment slot="description">
        <div id="summary" class="summary" role="status" aria-atomic="true">
            <p><strong id="scene-heading">표적이 벽 뒤로 이동합니다.</strong></p>
            <p id="scene-detail">사수에게는 서버보다 늦은 모습이 보입니다.</p>
        </div>
    </Fragment>
    <Fragment slot="overlays">
        <dialog id="explanation" aria-labelledby="explain-title">
            <div class="dialog-heading"><h2 id="explain-title">엄폐했는데도 맞는 이유</h2><button id="explain-close" aria-label="설명 닫기">×</button></div>
            <h3>사수와 표적은 서로 다른 순간을 봅니다.</h3>
            <p>벽은 처음부터 같은 자리에 있습니다. 표적이 달려가 벽 뒤로 숨지만, 사수의 화면에는 아직 벽 밖에 있던 모습이 남아 있습니다. 사수 시점으로 바꾸면 늦게 도착한 장면을, 자유·표적 시점에서는 서버 장면을 봅니다.</p>
            <h3>현재 모습으로 검사하면 빗나갑니다.</h3>
            <p>지연 보상을 끄고 같은 사격을 재생하세요. 사수는 벽 밖의 위치를 쐈지만, 표적은 이미 벽 뒤로 이동했습니다. 그 위치에는 이제 표적이 없어 사격이 빗나갑니다.</p>
            <h3>서버는 사수가 본 과거를 검사합니다.</h3>
            <p>지연 보상을 켜면 청록색 잔상과 광선이 검사에 쓴 과거 위치를 보여줍니다. 현재 캐릭터를 되돌리는 것이 아니라 저장된 충돌 상태를 조회합니다. 벽 밖에 있던 표적에 맞았다면, 이미 벽 뒤로 숨은 현재 표적에게 피해가 반영됩니다. 벽은 과거에도 지금도 같은 위치에 있으므로, 벽을 향해 쏜 한 발은 보상 여부와 관계없이 막힙니다.</p>
            <h3>이 장면의 시간</h3>
            <p>판정 순간을 1000ms로 고정했습니다. 사수가 본 시각은 1000ms에서 두 편도 지연과 보간 대기를 뺀 값입니다. 총구 섬광과 주황 궤적은 순간 사격의 기록이고, 청록 광선은 서버의 검사입니다. 총알이 천천히 날아가는 시간이 지연의 원인은 아닙니다. 판정 뒤에는 현재 장면을 멈춰 결과를 살펴봅니다.</p>
            <h3>더 살펴보기</h3>
            <p>조준 위치, 보관 이력, 틱 보간을 바꿔보세요. 순간이동 전후는 보간하지 않습니다. 고급 설정의 중복·미래 시각·오래된 명령 검사로 서버가 받아들이는 사격의 범위도 비교할 수 있습니다.</p>
            <p class="sources"><a href="https://doc.photonengine.com/fusion/v2/manual/advanced/lag-compensation">Photon Fusion · Lag Compensation ↗</a><br /><a href="https://playvalorant.com/en-gb/news/dev/the-state-of-hit-registration/">VALORANT · The State of Hit Registration ↗</a></p>
        </dialog>
    </Fragment>
    <script>
        import '../../experiments/lag-compensation/client';
    </script>
</ExperimentLayout>

<style>
    :global(.experiment-shell.lag-lab) { --experiment-graphics-min-height: 430px; --experiment-graphics-mobile-min-height: 430px; }
    .eyebrow { color: #31857c; font-size: 11px; font-weight: 700; letter-spacing: .09em; }
    .clip-controls { width: 100%; }
    :global(.lag-lab .experiment-settings-content) label { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 18px 0 6px; font-size: 12px; font-weight: 650; }
    .clip-controls label:first-child { margin-top: 2px; }
    output { color: #287b73; font-variant-numeric: tabular-nums; font-size: 12px; white-space: nowrap; }
    input[type='range'] { display: block; width: 100%; min-height: 30px; margin: 0; accent-color: #2f8278; cursor: pointer; }
    select { width: 100%; min-height: 40px; padding: 8px; border: 1px solid #d6e0e2; border-radius: 8px; background: #fff; color: #304c55; font-size: 12px; }
    .timeline-marks { display: flex; justify-content: space-between; color: #73878e; font-size: 10px; }
    .action-button { width: 100%; min-height: 36px; margin-top: 10px; padding: 8px; border: 1px solid #d8e3e4; border-radius: 8px; background: #f6f9f9; color: #356363; font: inherit; font-size: 12px; cursor: pointer; }
    .action-button:hover { background: #e9f1ee; }
    .action-button:disabled { opacity: .45; cursor: default; }
    .compare-button { border-color: #bcd8d0; background: #eaf5ef; }
    .history-toggle { min-width: 0; border: 1px solid #dce3e6; border-radius: 8px; color: #617581; background: #fff; cursor: pointer; }
    .history-toggle[aria-pressed='true'] { color: #247d72; background: #e0f0e8; border-color: #bfddd2; }
    .advanced { margin-top: 24px; border-top: 1px solid #e0e8e9; padding-top: 16px; }
    .advanced summary { font-size: 12px; color: #536e78; cursor: pointer; }
    :global(.lag-lab .experiment-settings-content) .check { justify-content: flex-start; line-height: 1.5; font-weight: 500; }
    .check input { width: 17px; height: 17px; accent-color: #2e8077; }
    .small-status { margin: 10px 0 0; font-size: 11px; line-height: 1.7; color: #6a8189; overflow-wrap: anywhere; }
    .small-status:empty { display: none; }
    .stage { position: relative; width: 100%; height: 100%; overflow: hidden; border-radius: 16px; background: #dae4e5; isolation: isolate; }
    canvas { display: block; width: 100%; height: 100%; touch-action: none; }
    canvas:focus-visible { outline: 2px solid #35897f; outline-offset: -3px; }
    .scene-footer { position: absolute; left: 20px; right: 20px; bottom: 16px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 12px; pointer-events: none; }
    .legend { display: flex; flex-wrap: wrap; gap: 12px; }
    .legend span, .camera-hint { color: #415f66; font-size: 10px; text-shadow: 0 1px 2px #fff; }
    .legend span::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-right: 5px; vertical-align: 1px; }
    .target-key::before { background: #d97759; }
    .shot-key::before { background: #e9a638; }
    .history-key::before { background: #279e96; }
    .touch-hint { display: none; }
    .scene-error { position: absolute; inset: 35% 24px auto; padding: 18px; border-radius: 10px; background: #fff; color: #684a43; line-height: 1.7; }
    .summary { min-height: 48px; font-size: 13px; line-height: 1.8; color: #506a73; word-break: keep-all; overflow-wrap: anywhere; }
    .summary p { margin: 0; }
    .summary strong { color: #304c55; font-weight: 600; }
    dialog { width: min(630px, calc(100vw - 30px)); max-height: calc(100svh - 32px); padding: 26px; border: 1px solid #d1dfdf; border-radius: 16px; background: #f9fbfb; color: #30464f; overflow: auto; }
    dialog::backdrop { background: #16384470; }
    .dialog-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .dialog-heading h2 { font-size: 20px; margin: 0; }
    .dialog-heading button { width: 36px; height: 36px; border: 0; border-radius: 8px; background: #eaf0f0; font-size: 24px; color: #45616b; cursor: pointer; }
    dialog h3 { margin: 24px 0 8px; font-size: 15px; }
    dialog p { font-size: 13px; line-height: 1.85; margin: 0; word-break: keep-all; }
    dialog .sources { margin-top: 24px; }
    dialog a { color: #217d72; }
    @media (max-width: 800px) {
        .scene-footer { left: 12px; right: 12px; bottom: 14px; flex-direction: column; gap: 8px; }
        .desktop-hint { display: none; }
        .touch-hint { display: inline; }
        .legend { gap: 8px; }
    }
</style>
